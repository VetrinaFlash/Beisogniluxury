{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beisogniluxury",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "venus-inn-db" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "venus-inn-photos" }
  ],
  "vars": {
    "SITE_NAME": "Venus Inn B&B Positano",
    "SITE_URL": "https://www.sleepingpositano.com",
    "OWNER_EMAIL": "sleepingpositano@yahoo.it",
    "EMAIL_FROM": "Venus Inn Positano <prenotazioni@example.com>"
  }
}
